PROJECT_NAME=phone-voice-insight
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Only enable a private IP exception after enterprise network approval.
SSRF_ALLOWED_HOSTS=club.honor.com
SSRF_ALLOWED_PRIVATE_IPS=
CSRF_TRUSTED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
TIME_ZONE=Asia/Shanghai
LOG_LEVEL=INFO
UV_DEFAULT_INDEX_URL=https://pypi.org/simple

APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8088
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

POSTGRES_DB=phone_voice_insight
POSTGRES_USER=pvi
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=5

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_PUBLIC_BASE=/
CORS_ALLOWED_ORIGINS=http://localhost:5173

AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_THINKING_MODE=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_CONCURRENCY=2
AI_TEMPERATURE=0
AI_MAX_OUTPUT_TOKENS=1500
AI_ALLOW_FAKE_PROVIDER=false
AI_AUTOMATION_ENABLED=false
AI_AUTOMATION_BATCH_SIZE=10
AI_AUTOMATION_MAX_ATTEMPTS=2
AI_AUTOMATION_DAILY_TOKEN_BUDGET=100000
AI_AUTOMATION_REQUESTS_PER_MINUTE=6
AI_LIVE_ACCEPTANCE_ENABLED=false
AI_LIVE_ACCEPTANCE_MAX_ITEMS=10
DASHBOARD_WATCH_MIN_COUNT=5
DASHBOARD_WATCH_GROWTH_PERCENT=50
DASHBOARD_COMPARISON_MIN_SAMPLE=30
DASHBOARD_REFRESH_SECONDS=300
AI_CREDENTIAL_ENCRYPTION_KEY=
