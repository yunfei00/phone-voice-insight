{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phone-voice-insight.local/schemas/structured_analysis_v1.schema.json",
  "title": "Phone Voice Insight Structured Analysis V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_version", "overall_sentiment", "language", "content_type", "relevance", "summary", "model_mentions", "aspects"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "taxonomy_version": {"const": "1.0.0"},
    "overall_sentiment": {"enum": ["POSITIVE", "NEUTRAL", "NEGATIVE", "MIXED", "UNKNOWN"]},
    "language": {"type": "string", "minLength": 2, "maxLength": 20},
    "content_type": {"enum": ["USER_REVIEW", "COMMUNITY_THREAD", "COMMUNITY_REPLY", "OFFICIAL_REPLY", "LOGISTICS_OR_SERVICE", "OTHER"]},
    "relevance": {"enum": ["RELEVANT", "PARTIAL", "IRRELEVANT", "UNKNOWN"]},
    "summary": {"type": "string", "maxLength": 500},
    "model_mentions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "aspects": {"type": "array", "items": {"$ref": "#/$defs/aspect"}}
  },
  "$defs": {
    "aspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_domains", "aspect_code", "topic_code", "sentiment", "intent", "issue_type", "severity", "scenario", "trigger", "phenomenon", "target_product", "compared_products", "relation_type", "evidence_text", "evidence_start", "evidence_end", "confidence", "review_required"],
      "properties": {
        "business_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["BAT", "PERF", "THERM", "DISP", "CAM", "NET", "SYS", "HW", "AI", "SEC", "ECO", "VALUE", "SERVICE", "NEED", "OTHER"]}},
        "aspect_code": {"enum": ["BAT", "PERF", "THERM", "DISP", "CAM", "NET", "SYS", "HW", "AI", "SEC", "ECO", "VALUE", "SERVICE", "NEED", "OTHER"]},
        "topic_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*\\.[A-Z][A-Z0-9_]*$"},
        "sentiment": {"enum": ["POSITIVE", "NEUTRAL", "NEGATIVE", "MIXED", "UNKNOWN"]},
        "intent": {"enum": ["EXPERIENCE", "COMPLAINT", "PRAISE", "QUESTION", "SUGGESTION", "COMPARISON", "PURCHASE_INTENT", "SERVICE_REQUEST", "OTHER", "UNKNOWN"]},
        "issue_type": {"enum": ["QUALITY", "PERFORMANCE", "USABILITY", "COMPATIBILITY", "RELIABILITY", "PRIVACY", "SERVICE", "PRICE", "REQUIREMENT", "OTHER", "UNKNOWN"]},
        "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO", "UNKNOWN"]},
        "scenario": {"type": ["string", "null"]},
        "trigger": {"type": ["string", "null"]},
        "phenomenon": {"type": ["string", "null"]},
        "target_product": {"type": ["string", "null"]},
        "compared_products": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "relation_type": {"enum": ["SELF", "COMPARED_WITH", "MENTION_ONLY", "UNKNOWN"]},
        "evidence_text": {"type": "string", "minLength": 1},
        "evidence_start": {"type": "integer", "minimum": 0},
        "evidence_end": {"type": "integer", "minimum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "review_required": {"type": "boolean"}
      }
    }
  }
}
